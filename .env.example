# Copy to .env (make does it automatically). DEV VALUES ONLY - never reuse in production.
POSTGRES_USER=eximphone
POSTGRES_PASSWORD=dev-postgres-change-me
POSTGRES_DB=eximphone
REDIS_PASSWORD=dev-redis-change-me
# Garage S3: key id must be GK + 24 hex chars, secret 64 hex chars, rpc secret 64 hex chars.
S3_ACCESS_KEY_ID=GK0123456789abcdef01234567
S3_SECRET_ACCESS_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
GARAGE_RPC_SECRET=fedcba9876543210fedcba9876543210fedcba9876543210fedcba9876543210
LDAP_ADMIN_PASSWORD=dev-ldap-change-me
JWT_SECRET=dev-jwt-secret-change-me-at-least-32-chars
# Chat at-rest encryption key (AES-256-GCM, 64 hex chars). Keep it OUTSIDE the database and back it up separately.
MESSAGE_KEY=00112233445566778899aabbccddeeff00112233445566778899aabbccddeeff
LOG_LEVEL=info
# Directory. Dev points at ldap-mock; in production use the Active Directory (ldaps://) and a read-only service account.
LDAP_URL=ldap://ldap-mock:389
LDAP_BASE_DN=ou=people,dc=exim,dc=local
LDAP_USER_ATTR=uid
LDAP_BIND_DN=cn=admin,dc=exim,dc=local
LDAP_BIND_PASSWORD=dev-ldap-change-me

# Calls: shared secrets and the address clients use to reach media/turn (dev: this machine).
INTERNAL_TOKEN=dev-internal-token-change-me
TURN_SECRET=dev-turn-secret-change-me
PUBLIC_IP=127.0.0.1
# SIP device secrets key (AES-256-GCM, 64 hex). SIP_DOMAIN is the digest realm; INITIAL_IT_ADMINS bootstraps the first it_admin users (dev only).
SIP_KEY=8899aabbccddeeff00112233445566778899aabbccddeeff0011223344556677
SIP_DOMAIN=exim.local
INITIAL_IT_ADMINS=asaid
# Heads of service for tickets (they approve/reject and assign tickets of their service): Department=user1,user2;Other=user3
INITIAL_DEPT_HEADS="IT=asaid;HR=mjuma;Finance=hbakari;Operations=oabdallah;Communication=imoussa"
# Call recordings and attachments at rest (AES-256-GCM, 64 hex). Back this key up SEPARATELY from the database.
RECORDING_KEY=a1b2c3d4e5f60718293a4b5c6d7e8f90a1b2c3d4e5f60718293a4b5c6d7e8f90
RECORDING_RETENTION_DAYS=365
# Passphrase protecting backups (keep it outside the server)
BACKUP_PASSPHRASE=dev-backup-passphrase-change-me

# Copy to .env (make does it automatically). DEV VALUES ONLY - never reuse in production.
POSTGRES_USER=eximphone
POSTGRES_PASSWORD=dev-postgres-change-me
POSTGRES_DB=eximphone
REDIS_PASSWORD=dev-redis-change-me
# Garage S3: key id must be GK + 24 hex chars, secret 64 hex chars, rpc secret 64 hex chars.
S3_ACCESS_KEY_ID=GK0123456789abcdef01234567
S3_SECRET_ACCESS_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
GARAGE_RPC_SECRET=fedcba9876543210fedcba9876543210fedcba9876543210fedcba9876543210
LDAP_ADMIN_PASSWORD=dev-ldap-change-me
JWT_SECRET=dev-jwt-secret-change-me-at-least-32-chars
LOG_LEVEL=info

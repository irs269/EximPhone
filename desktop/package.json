{
  "name": "eximphone-desktop",
  "version": "0.1.0",
  "description": "Exim Connect desktop client for Exim Bank",
  "author": "Exim Bank",
  "private": true,
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win",
    "test": "node --test test/remote.test.js"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "tz.eximbank.eximphone",
    "productName": "Exim Connect",
    "files": [
      "main.js",
      "offline.html",
      "preload.js",
      "ui-preload.js",
      "remote.js",
      "keymap.js",
      "winDriver.js",
      "picker.html",
      "banner.html",
      "defaults.json"
    ],
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": true,
      "allowToChangeInstallationDirectory": true
    },
    "asarUnpack": [
      "node_modules/koffi/**"
    ]
  },
  "dependencies": {
    "koffi": "^3.3.8"
  }
}

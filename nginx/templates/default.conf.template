# Per-IP request limits: the login is the brute-force target, the API gets a generous ceiling.
limit_req_zone $binary_remote_addr zone=login:10m rate=${NGINX_LOGIN_RATE};
limit_req_zone $binary_remote_addr zone=api:10m rate=${NGINX_API_RATE};
limit_req_status 429;

server {
    listen 443 ssl;
    http2 on;
    server_name _;

    ssl_certificate     /etc/nginx/certs/server.crt;
    ssl_certificate_key /etc/nginx/certs/server.key;
    ssl_protocols       TLSv1.2 TLSv1.3;

    server_tokens off;
    client_max_body_size 21m;   # chat attachments: 20 MB max + overhead

    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
    add_header X-Frame-Options "DENY" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "same-origin" always;
    add_header Content-Security-Policy "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self' wss:; frame-ancestors 'none'" always;

    location = /nginx-health { access_log off; return 200 "ok\n"; }

    # Docker DNS is re-resolved so containers recreated with a new IP keep working.
    resolver 127.0.0.11 valid=5s ipv6=off;

    location = /api/ws {
        set $api_upstream http://api:8080;
        rewrite ^/api/ws$ /ws break;
        proxy_pass $api_upstream;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $http_host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_read_timeout 3600s;
    }

    location ^~ /api/internal { return 404; }

    location = /api/auth/login {
        limit_req zone=login burst=${NGINX_LOGIN_BURST} nodelay;
        set $api_upstream http://api:8080;
        rewrite ^/api/(.*)$ /$1 break;
        proxy_pass $api_upstream;
        proxy_set_header Host $http_host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location /api/ {
        limit_req zone=api burst=${NGINX_API_BURST} nodelay;
        set $api_upstream http://api:8080;
        rewrite ^/api/(.*)$ /$1 break;
        proxy_pass $api_upstream;
        proxy_set_header Host $http_host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location /ws {
        set $api_upstream http://api:8080;
        proxy_pass $api_upstream;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $http_host;
        proxy_read_timeout 3600s;
    }

    # WebRTC offer/answer for calls (RTP itself goes straight to media over UDP).
    location /media/calls/ {
        set $media_upstream http://media:8080;
        rewrite ^/media/(.*)$ /$1 break;
        proxy_pass $media_upstream;
        proxy_set_header Host $http_host;
    }

    location /prov/ {
        set $prov_upstream http://provisioning:8080;
        rewrite ^/prov/(.*)$ /$1 break;
        proxy_pass $prov_upstream;
        proxy_set_header X-Real-IP $remote_addr;
    }

    location / {
        root /usr/share/nginx/html;
        try_files $uri /index.html;
    }
}
